# ============================================
# DATABASE
# ============================================
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://username:password@localhost:3306/attendance_db"

# ============================================
# JWT
# ============================================
# Minimal 32 karakter, gunakan string acak
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_random_string_here_minimal_32_chars

# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# CORS
# ============================================
# Comma-separated untuk multiple origins
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Seed Secret (untuk endpoint /api/seed — jangan dishare!)
SEED_SECRET=your_random_seed_secret_minimal_32_chars