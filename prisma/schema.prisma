generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// 1. OFFICES
model Office {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  latitude  Float
  longitude Float
  radius    Float
  jamMasuk  String   @map("jam_masuk") @db.VarChar(5)
  jamPulang String   @map("jam_pulang") @db.VarChar(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]

  @@map("offices")
}

// 2. USERS
model User {
  id                 Int          @id @default(autoincrement())
  officeId           Int?         @map("office_id")
  nik                String       @unique @db.VarChar(50)
  nama               String       @db.VarChar(100)
  email              String       @unique @db.VarChar(100)
  password           String       @db.VarChar(255)
  role               Role         @default(KARYAWAN)
  fotoProfil         String?      @map("foto_profil") @db.VarChar(255)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  office             Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  attendances        Attendance[]
  permissions        Permission[] @relation("UserPermissions")
  approvedPermissions Permission[] @relation("ApprovedPermissions")
  auditLogs          AuditLog[]

  @@map("users")
}

enum Role {
  KARYAWAN
  HRD
  ADMIN
}

enum StatusMasuk {
  TEPAT_WAKTU
  TERLAMBAT
}

enum MetodeMasuk {
  GPS
  MANUAL
}

// 3. ATTENDANCES
model Attendance {
  id          Int          @id @default(autoincrement())
  userId      Int          @map("user_id")
  tanggal     DateTime     @db.Date
  jamMasuk    DateTime?    @map("jam_masuk")
  jamPulang   DateTime?    @map("jam_pulang")
  latMasuk    Float?       @map("lat_masuk")
  lngMasuk    Float?       @map("lng_masuk")
  fotoMasuk   String?      @map("foto_masuk") @db.VarChar(255)
  latPulang   Float?       @map("lat_pulang")
  lngPulang   Float?       @map("lng_pulang")
  fotoPulang  String?      @map("foto_pulang") @db.VarChar(255)
  statusMasuk StatusMasuk? @map("status_masuk")
  metodeMasuk MetodeMasuk? @map("metode_masuk")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

// 4. PERMISSIONS
model Permission {
  id              Int              @id @default(autoincrement())
  userId          Int              @map("user_id")
  approvedBy      Int?             @map("approved_by")
  jenis           JenisIzin
  tanggalMulai    DateTime         @map("tanggal_mulai") @db.Date
  tanggalSelesai  DateTime         @map("tanggal_selesai") @db.Date
  alasan          String           @db.Text
  buktiFile       String?          @map("bukti_file") @db.VarChar(255)
  status          StatusPermission @default(PENDING)
  rejectionReason String?          @map("rejection_reason") @db.Text  // ← BARU
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  approver        User?            @relation("ApprovedPermissions", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@map("permissions")
}

enum JenisIzin {
  IZIN
  SAKIT
  CUTI
}

enum StatusPermission {
  PENDING
  APPROVED
  REJECTED
}

// 5. AUDIT LOGS
model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String   @db.VarChar(50)
  entity      String   @db.VarChar(50)
  entityId    Int?     @map("entity_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  description String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}